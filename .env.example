# Client (safe to expose — shipped in the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (used by /api/login — never exposed to the browser).
# From Supabase → Settings → API. Do NOT prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Website lead webhook (used by /api/lead-webhook)
LEAD_WEBHOOK_SECRET=a_long_random_shared_secret
LEAD_DEFAULT_ASSIGNEE=
